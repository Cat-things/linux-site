---
import { repoFile } from '../data/site';

interface Props {
  path: string | string[];
  label?: string;
  class?: string;
}
const { path, label = 'source', class: className } = Astro.props;
const paths = Array.isArray(path) ? path : [path];
---

<span class:list={['source', className]}>
  <span aria-hidden="true">{label}</span>
  <span class="visually-hidden">{label === 'source' ? 'Source file in the distro repo:' : label}</span>
  {
    paths.map((p, i) => (
      <>
        <a href={repoFile(p)}>{p}</a>
        {i < paths.length - 1 && <span aria-hidden="true">·</span>}
      </>
    ))
  }
</span>
